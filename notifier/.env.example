# Same Postgres the ingestion job writes to.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Resend (https://resend.com) — the sending domain must be verified.
RESEND_API_KEY=re_xxxxxxxxxxxx
NOTIFIER_FROM=Morocco Opportunities <alerts@your-domain.ma>

# Used to build links in the emails. No trailing slash.
SITE_URL=https://your-deployment.vercel.app

# Safety rails: a ceiling per run, and one email per person per run.
NOTIFIER_MAX_EMAILS=200
NOTIFIER_MAX_PER_USER=1
