{
  "name": "penitence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Blasphemous-like 2D action-platformer: parry combat, an interconnected map, and a penance system.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "bundle": "npm run build && node tools/inline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run bundle && node tools/smoke.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
