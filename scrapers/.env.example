# Postgres connection used by the ingestion job.
#
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the *session*/direct connection (not the transaction pooler) so that
# prepared statements and multi-statement transactions work.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Identify the crawler honestly, with a way to reach you.
SCRAPER_USER_AGENT=MoroccoOpportunitiesBot/0.1 (+https://github.com/omarbusiness107-tech/cli-game-)

# Politeness. Delay is a floor: a stricter robots.txt Crawl-delay wins.
SCRAPER_DELAY=2.0
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3

# Leave true. Only a site owner's written permission justifies flipping it.
SCRAPER_RESPECT_ROBOTS=true
